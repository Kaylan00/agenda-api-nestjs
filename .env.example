# Copie para .env (cp .env.example .env)
PORT=3000
# Banco de desenvolvimento (docker compose up -d db)
DATABASE_URL="postgresql://agenda:agenda@localhost:5432/agenda?schema=public"
# Banco usado pelos testes e2e (docker compose --profile test up -d db-test)
TEST_DATABASE_URL="postgresql://agenda:agenda@localhost:5433/agenda_test?schema=public"
